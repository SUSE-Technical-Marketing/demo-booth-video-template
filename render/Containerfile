# Renders a booth video with no DaVinci Resolve and nothing installed on the host.
#   docker build -t booth-render -f render/Containerfile .
#   render/run-container.sh my-edit.mp4 -t my-video.json -o my-video-final.mp4
# Base: SUSE Linux Enterprise Base Container Image (BCI) with Python. Check
# https://registry.suse.com/repositories/bci-python313 for the current tag and support dates.
FROM registry.suse.com/bci/python:3.13

WORKDIR /app
# Pillow draws the layout; imageio-ffmpeg bundles a static ffmpeg (with the H.264 encoder), so no zypper or
# extra repositories are needed for codecs.
COPY render/requirements.txt render/requirements.txt
RUN pip install --no-cache-dir -r render/requirements.txt

COPY render/ render/
COPY assets/ assets/
COPY timings/ timings/

# Videos are mounted at /work (the current directory). timings/ is usually mounted over /app/timings so edits to
# your timing files are picked up without a rebuild.
WORKDIR /work
ENTRYPOINT ["python3", "/app/render/render.py"]
CMD ["--help"]
