# The whole app with nothing installed on the host: the editor (built) and the export service in one image.
#   docker build -t booth-render -f render/Containerfile .
#   render/run-container.sh --ui                 # editor + export at http://127.0.0.1:8765, open it in Chrome or Edge
#   render/run-container.sh project.json -o my-video-final.mp4      # or render one project from the command line
# Base: SUSE Linux Enterprise Base Container Image (BCI). Check https://registry.suse.com for current tags and
# support dates.

# ---- stage 1: build the editor (Node and Bun live only in this stage, not in the final image) ----
FROM registry.suse.com/bci/nodejs:24 AS editor
WORKDIR /src
RUN npm install --global bun@1.3.14
COPY package.json bun.lock vite.config.js ./
RUN bun install --frozen-lockfile
COPY editor/ editor/
COPY assets/ assets/
RUN bun run build

# ---- stage 2: renderer + export service + the built editor ----
FROM registry.suse.com/bci/python:3.13

WORKDIR /app
# Pillow draws the layout; imageio-ffmpeg bundles a static ffmpeg (with the H.264 encoder), so no zypper or
# extra repositories are needed for codecs.
COPY render/requirements.txt render/requirements.txt
RUN pip install --no-cache-dir -r render/requirements.txt

COPY render/ render/
COPY assets/ assets/
COPY timings/ timings/
COPY --from=editor /src/dist dist/

# Command-line renders: projects and their relative source media are mounted by run-container.sh.
# --ui replaces the entrypoint with the export service, which also serves dist/ (see run-container.sh).
WORKDIR /work
EXPOSE 8765
ENTRYPOINT ["python3", "/app/render/render.py"]
CMD ["--help"]
